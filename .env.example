# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Postgres (docker-compose) ---
POSTGRES_PORT=5441
POSTGRES_PASSWORD=change-me-bootstrap
P11_MIGRATOR_PASSWORD=change-me-migrator
P11_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql://p11_app:change-me-app@127.0.0.1:5441/p11
MIGRATOR_DATABASE_URL=postgresql://p11_migrator:change-me-migrator@127.0.0.1:5441/p11

# --- Safety ---
DRY_RUN=true                 # SMS, CRM and calendar writes are logged, not performed
PHONE_HASH_KEY=change-me-long-random-string   # HMAC key: phone numbers in logs/traces
LOG_LEVEL=INFO

# --- LLM for post-call analysis and the text eval (a NEW key in its own Console workspace with a spend limit) ---
ANTHROPIC_API_KEY=

# --- Langfuse (a new project "p11-voice-receptionist") ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Vapi (Phase 0 spike) ---
VAPI_API_KEY=                # private key, used only by `make sync-assistant`
VAPI_WEBHOOK_SECRET=         # long random string; Vapi sends it on every request, we reject anything else
VAPI_ASSISTANT_ID=
PUBLIC_BASE_URL=             # the cloudflared tunnel URL printed by `make tunnel`

# --- Real integrations (later phases). Defaults are fakes; DRY_RUN stays true until you say so ---
CALENDAR_BACKEND=fake        # fake | google
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=     # path to the service-account JSON (keep it outside the repo)
CRM_BACKEND=fake             # fake | hubspot
HUBSPOT_TOKEN=
